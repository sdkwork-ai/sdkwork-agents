{
  "name": "@sdkwork/agents-app-sdk",
  "version": "0.1.4",
  "description": "SDKWork agent app API TypeScript SDK boundary.",
  "type": "module",
  "private": false,
  "sdkwork": {
    "sdkName": "sdkwork-agents-app-sdk",
    "authority": "sdkwork-agents-app-api",
    "apiPrefix": "/app/v3/api",
    "sdkType": "app",
    "sdkSurface": "app",
    "generatedOutput": "generated/server-openapi",
    "standardProfile": "sdkwork-v3",
    "sdkOwner": "sdkwork-agents",
    "sdkDependencies": [
      {
        "workspace": "sdkwork-iam-app-sdk",
        "role": "appbase-identity-and-session-capability",
        "required": true,
        "dependencyMode": "consumer-sdk",
        "apiPrefix": "/app/v3/api",
        "apiAuthority": "sdkwork-iam-app-api",
        "generatedTransportImportPolicy": "forbidden",
        "packageByLanguage": {
          "typescript": "@sdkwork/iam-app-sdk"
        }
      },
      {
        "workspace": "sdkwork-drive-app-sdk",
        "role": "drive-uploader-file-storage-capability",
        "required": true,
        "dependencyMode": "consumer-sdk",
        "apiPrefix": "/app/v3/api",
        "apiAuthority": "sdkwork-drive.app",
        "generatedTransportImportPolicy": "forbidden",
        "packageByLanguage": {
          "typescript": "@sdkwork/drive-app-sdk"
        }
      },
      {
        "workspace": "sdkwork-prompts-app-sdk",
        "role": "project-instructions-capability",
        "required": true,
        "dependencyMode": "consumer-sdk",
        "apiPrefix": "/app/v3/api",
        "apiAuthority": "sdkwork-prompts-app-api",
        "generatedTransportImportPolicy": "forbidden",
        "packageByLanguage": {
          "typescript": "@sdkwork/prompts-app-sdk"
        }
      },
      {
        "workspace": "sdkwork-memory-app-sdk",
        "role": "project-memory-selection-capability",
        "required": true,
        "dependencyMode": "consumer-sdk",
        "apiPrefix": "/app/v3/api",
        "apiAuthority": "sdkwork-memory.app",
        "generatedTransportImportPolicy": "forbidden",
        "packageByLanguage": {
          "typescript": "@sdkwork/memory-app-sdk"
        }
      },
      {
        "workspace": "sdkwork-documents-app-sdk",
        "role": "project-document-selection-capability",
        "required": true,
        "dependencyMode": "consumer-sdk",
        "apiPrefix": "/app/v3/api",
        "apiAuthority": "sdkwork-documents-app-api",
        "generatedTransportImportPolicy": "forbidden",
        "packageByLanguage": {
          "typescript": "@sdkwork/documents-app-sdk"
        }
      }
    ]
  },
  "scripts": {
    "generate:dry-run": "node ../../workspace-agent-sdkgen.mjs --family app --mode dry-run",
    "generate": "node ../../workspace-agent-sdkgen.mjs --family app --mode apply",
    "test": "tsx --test tests/base-url.test.ts",
    "build": "pnpm run test && node ../bin/verify-sdk.mjs",
    "verify": "pnpm run test && node ../bin/verify-sdk.mjs"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "dependencies": {
    "@sdkwork/sdk-common": "^1.0.5",
    "@sdkwork/utils": "^0.11.0"
  },
  "devDependencies": {
    "tsx": "catalog:"
  },
  "files": [
    "src",
    "dist",
    "composed",
    "generated/server-openapi/dist",
    "generated/server-openapi/src",
    "generated/server-openapi/sdkwork-sdk.json",
    "generated/server-openapi/README.md",
    "generated/server-openapi/LICENSE",
    "generated/domains/server-openapi/dist",
    "generated/domains/server-openapi/src",
    "generated/domains/server-openapi/sdkwork-sdk.json",
    "generated/domains/server-openapi/README.md",
    "generated/domains/server-openapi/LICENSE",
    "README.md",
    "LICENSE"
  ]
}
