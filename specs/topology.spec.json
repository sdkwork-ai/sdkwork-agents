{
  "schemaVersion": 5,
  "kind": "sdkwork.app.topology",
  "appId": "sdkwork-agents",
  "applicationCode": "agents",
  "archetype": "application-http-gateway",
  "profileRoot": "etc/topology",
  "profilePattern": "{deploymentProfile}.{environment}.env",
  "vocabulary": {
    "deploymentProfile": {
      "allowed": [
        "standalone",
        "cloud"
      ]
    },
    "environment": {
      "allowed": [
        "development",
        "test",
        "staging",
        "production"
      ]
    }
  },
  "defaults": {
    "developmentProfileId": "standalone.development",
    "productionProfileId": "cloud.production",
    "desktopBuildProfileId": "standalone.production"
  },
  "profileFiles": {
    "standalone.development": "etc/topology/standalone.development.env",
    "standalone.test": "etc/topology/standalone.test.env",
    "standalone.staging": "etc/topology/standalone.staging.env",
    "standalone.production": "etc/topology/standalone.production.env",
    "cloud.development": "etc/topology/cloud.development.env",
    "cloud.test": "etc/topology/cloud.test.env",
    "cloud.staging": "etc/topology/cloud.staging.env",
    "cloud.production": "etc/topology/cloud.production.env"
  },
  "envKeys": {
    "deploymentProfile": "SDKWORK_AGENTS_DEPLOYMENT_PROFILE",
    "environment": "SDKWORK_AGENTS_ENVIRONMENT",
    "sharedEnvironment": "SDKWORK_ENVIRONMENT",
    "sharedCorsAllowedOrigins": "SDKWORK_CORS_ALLOWED_ORIGINS",
    "profileId": "SDKWORK_AGENTS_PROFILE_ID",
    "clientDeploymentProfile": "VITE_SDKWORK_AGENTS_DEPLOYMENT_PROFILE",
    "standaloneGatewayBind": "SDKWORK_AGENTS_APPLICATION_PUBLIC_INGRESS_BIND",
    "taskWorkerBind": "SDKWORK_AGENTS_TASK_WORKER_BIND",
    "taskWorkerHttpUrl": "SDKWORK_AGENTS_TASK_WORKER_HTTP_URL",
    "clientApiGatewayBaseUrl": "VITE_SDKWORK_AGENTS_PLATFORM_API_GATEWAY_HTTP_URL",
    "apiGatewayBaseUrl": "SDKWORK_AGENTS_PLATFORM_API_GATEWAY_HTTP_URL"
  },
  "surfaces": {
    "application.public-ingress": {
      "connectivityPlane": "application",
      "protocols": [
        "http"
      ],
      "bindEnv": "SDKWORK_AGENTS_APPLICATION_PUBLIC_INGRESS_BIND",
      "httpUrlEnv": "SDKWORK_AGENTS_APPLICATION_PUBLIC_HTTP_URL",
      "clientHttpEnv": "VITE_SDKWORK_AGENTS_APPLICATION_PUBLIC_HTTP_URL"
    },
    "application.backend-http": {
      "connectivityPlane": "application",
      "protocols": [
        "http"
      ],
      "bindEnv": "SDKWORK_AGENTS_APPLICATION_BACKEND_HTTP_BIND",
      "httpUrlEnv": "SDKWORK_AGENTS_APPLICATION_BACKEND_HTTP_URL",
      "clientHttpEnv": "VITE_SDKWORK_AGENTS_APPLICATION_BACKEND_HTTP_URL"
    },
    "application.open-http": {
      "connectivityPlane": "application",
      "protocols": [
        "http"
      ],
      "bindEnv": "SDKWORK_AGENTS_APPLICATION_OPEN_HTTP_BIND",
      "httpUrlEnv": "SDKWORK_AGENTS_APPLICATION_OPEN_HTTP_URL",
      "clientHttpEnv": "VITE_SDKWORK_AGENTS_APPLICATION_OPEN_HTTP_URL"
    },
    "application.app-http": {
      "connectivityPlane": "application",
      "protocols": [
        "http"
      ],
      "bindEnv": "SDKWORK_AGENTS_APPLICATION_APP_HTTP_BIND",
      "httpUrlEnv": "SDKWORK_AGENTS_APPLICATION_APP_HTTP_URL",
      "clientHttpEnv": "VITE_SDKWORK_AGENTS_APPLICATION_APP_HTTP_URL"
    },
    "application.task-worker-operations": {
      "connectivityPlane": "application",
      "protocols": [
        "http"
      ],
      "bindEnv": "SDKWORK_AGENTS_TASK_WORKER_BIND",
      "httpUrlEnv": "SDKWORK_AGENTS_TASK_WORKER_HTTP_URL"
    },
    "platform.api-gateway": {
      "connectivityPlane": "platform",
      "protocols": [
        "http"
      ],
      "httpUrlEnv": "SDKWORK_AGENTS_PLATFORM_API_GATEWAY_HTTP_URL",
      "clientHttpEnv": "VITE_SDKWORK_AGENTS_PLATFORM_API_GATEWAY_HTTP_URL"
    }
  },
  "components": {
    "appApiRouter": {
      "crate": "sdkwork-api-agents-standalone-gateway",
      "binary": "sdkwork-api-agents-standalone-gateway"
    },
    "backendApiRouter": {
      "crate": "sdkwork-api-agents-standalone-gateway",
      "binary": "sdkwork-api-agents-standalone-gateway"
    },
    "openApiRouter": {
      "crate": "sdkwork-api-agents-standalone-gateway",
      "binary": "sdkwork-api-agents-standalone-gateway"
    },
    "taskWorker": {
      "crate": "sdkwork-intelligence-agents-worker",
      "binary": "sdkwork-intelligence-agents-worker"
    }
  },
  "orchestration": {
    "profiles": {
      "standalone.development": {
        "processes": [
          {
            "id": "application.public-ingress",
            "crate": "sdkwork-api-agents-standalone-gateway",
            "binary": "sdkwork-api-agents-standalone-gateway",
            "required": true,
            "role": "api-standalone-gateway"
          },
          {
            "id": "application.task-worker",
            "crate": "sdkwork-intelligence-agents-worker",
            "binary": "sdkwork-intelligence-agents-worker",
            "required": true,
            "role": "worker",
            "bindEnv": "SDKWORK_AGENTS_TASK_WORKER_BIND"
          },
          {
            "id": "agents-browser",
            "role": "client",
            "applicationRoot": "apps/sdkwork-agents-pc",
            "bindEnv": "SDKWORK_AGENTS_WEB_DEV_INGRESS_BIND",
            "runtimeTargets": [
              "browser"
            ],
            "clientArchitectures": [
              "pc-web",
              "h5"
            ],
            "required": true
          }
        ],
        "healthSurfaces": [
          "application.public-ingress",
          "application.task-worker-operations"
        ],
        "browserDeliveries": [
          {
            "id": "agents-adaptive-web",
            "applicationRoot": "apps/sdkwork-agents-pc",
            "clientArchitectures": [
              "pc-web",
              "h5"
            ],
            "originMode": "same-origin",
            "deliveryMode": "dev-server-proxy",
            "clientProcessId": "agents-browser",
            "apiSurfaceId": "application.public-ingress",
            "preserveCanonicalPaths": true,
            "tabletArchitecture": "pc-web",
            "renderers": {
              "pc-web": {
                "applicationRoot": "apps/sdkwork-agents-pc",
                "script": "dev:standalone",
                "defaultPort": 5324,
                "portEnv": "SDKWORK_AGENTS_PC_INTERNAL_DEV_PORT",
                "env": {}
              },
              "h5": {
                "applicationRoot": "apps/sdkwork-agents-h5",
                "script": "dev:standalone",
                "defaultPort": 5325,
                "portEnv": "SDKWORK_AGENTS_H5_INTERNAL_DEV_PORT",
                "env": {}
