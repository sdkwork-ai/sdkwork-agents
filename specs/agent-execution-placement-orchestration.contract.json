          "trustedScope",
          "kernelPlacementId",
          "internalLeaseCredential",
          "expectedFencingGeneration",
          "reasonCode",
          "idempotencyKey",
          "deadlineAt",
          "traceId"
        ],
        "responseFields": [
          "state",
          "deliveryStatus",
          "reconciliationRequired",
          "fencingGeneration"
        ]
      },
      {
        "name": "restoreExecutionCheckpoint",
        "idempotency": "required-new-attempt",
