        "idempotency": "required",
        "requestFields": [
          "trustedScope",
          "kernelPlacementId",
          "internalLeaseCredential",
          "expectedFencingGeneration",
          "idempotencyKey",
          "deadlineAt",
          "traceId"
        ],
