          "state",
          "internalLeaseCredential",
          "fencingGeneration",
          "leaseExpiresAt",
          "readinessEvidenceRef"
        ]
      },
      {
        "name": "releaseExecutionPlacement",
        "idempotency": "required",
        "requestFields": [
          "trustedScope",
          "kernelPlacementId",
          "internalLeaseCredential",
          "expectedFencingGeneration",
          "releaseReason",
          "idempotencyKey",
          "deadlineAt",
          "traceId"
        ],
        "responseFields": [
          "state",
          "releaseStatus",
          "cleanupEvidenceRef",
          "reconciliationRequired"
        ]
      }
    ],
    "internalLeaseCredentialMayEnterProductApi": false,
    "fencingGenerationClientWritable": false
  },
