SDKWORK_AGENTS_CONFIG_PROFILE=dev
SDKWORK_AGENTS_RUNTIME_TARGET=container
SDKWORK_AGENTS_PROFILE_ID=standalone.demo
SDKWORK_AGENTS_TASK_WORKER_BIND=127.0.0.1:8096
SDKWORK_AGENTS_TASK_WORKER_HTTP_URL=http://127.0.0.1:8096

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_AGENTS_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

SDKWORK_AGENTS_APPLICATION_PUBLIC_INGRESS_BIND=127.0.0.1:8095
SDKWORK_AGENTS_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:8095
SDKWORK_AGENTS_APPLICATION_BACKEND_HTTP_BIND=127.0.0.1:8096
