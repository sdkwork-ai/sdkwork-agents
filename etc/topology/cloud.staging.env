# cloud.staging
# Replace all .invalid origins before exposing this profile to browser clients.
SDKWORK_AGENTS_DEPLOYMENT_PROFILE=cloud
SDKWORK_AGENTS_ENVIRONMENT=staging
SDKWORK_ENVIRONMENT=staging
SDKWORK_CORS_ALLOWED_ORIGINS=https://agents.staging.invalid
SDKWORK_AGENTS_CONFIG_PROFILE=staging
SDKWORK_AGENTS_RUNTIME_TARGET=container
SDKWORK_AGENTS_PROFILE_ID=cloud.staging
SDKWORK_AGENTS_TASK_WORKER_BIND=0.0.0.0:8096
SDKWORK_AGENTS_TASK_WORKER_HTTP_URL=http://sdkwork-intelligence-agents-worker:8096


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
