{
  "schemaVersion": 3,
  "kind": "agent.app",
  "app": {
    "key": "sdkwork-agents",
    "name": "sdkwork-agents",
    "displayName": "SDKWork Agents",
    "officialWebsiteUrl": "https://sdkwork.com",
    "appType": "NONE",
    "description": "SDKWork hosted agent product application composed from sdkwork-kernel.",
    "identifiers": {
      "containerImage": "sdkwork-agents"
    }
  },
  "backend": {
    "primaryLanguage": "rust",
    "framework": "axum",
    "appId": "sdkwork-agents",
    "tenantId": "100001",
    "organizationId": "0",
    "accessTokenPermissionScope": [
      "iam.users.read",
      "iam.organizations.read",
      "iam.roles.read",
      "iam.permissions.read"
    ]
  },
  "runtime": {
    "family": "server",
    "framework": "rust-service",
    "defaultPlatform": "API",
    "defaultArchitecture": "x64",
    "supportedDeploymentProfiles": ["standalone", "cloud"],
    "defaultDeploymentProfile": "standalone"
  },
  "media": {
    "icons": {
      "primary": {
        "id": "icon-primary",
        "type": "ICON",
        "purpose": "PRIMARY",
        "platform": "OTHER",
        "format": "PNG",
        "width": 1024,
        "height": 1024,
        "enabled": true,
        "url": "https://cdn.sdkwork.com/apps/sdkwork-agents/assets/icon-1024.png",
        "metadata": { "generatedPlaceholder": true }
      },
      "platform": []
    },
    "screenshots": [],
    "previews": []
  },
  "publish": {
    "status": "DRAFT",
    "platforms": ["API", "WEB", "CLI"],
    "installPlatforms": ["API"],
    "installSkill": false,
    "defaultPackageId": "linux-x64-standalone-server-tar-gz"
  },
  "artifacts": {
    "installConfig": {
      "defaultPackageId": "linux-x64-standalone-server-tar-gz",
      "packages": [
        {
          "id": "linux-x64-standalone-server-tar-gz",
          "name": "SDKWork Agents Linux x64 Standalone Server",
          "sourceType": "BINARY_URL",
          "packageFormat": "TAR_GZ",
          "platform": "API",
          "architecture": "x64",
          "profileBinding": "fixed",
          "deploymentProfile": "standalone",
          "runtimeTarget": "server",
          "url": "https://cdn.sdkwork.com/apps/sdkwork-agents/BETA/0.1.0/sdkwork-agents-linux-x64-standalone-server-tar-gz-0.1.0.tar.gz",
          "enabled": false,
          "checksumAlgorithm": "SHA-256",
          "metadata": {
            "packageProfile": "server",
            "releaseBuildDeferred": true,
            "releaseAuthority": "sdkwork-agents"
          }
        },
        {
          "id": "container-x64-cloud-container-kubernetes-tar-gz",
          "name": "SDKWork Agents Cloud Kubernetes Bundle",
          "sourceType": "BINARY_URL",
          "packageFormat": "TAR_GZ",
          "platform": "API",
          "architecture": "x64",
          "profileBinding": "fixed",
          "deploymentProfile": "cloud",
          "runtimeTarget": "container",
          "url": "https://cdn.sdkwork.com/apps/sdkwork-agents/BETA/0.1.0/sdkwork-agents-container-x64-cloud-container-kubernetes-tar-gz-0.1.0.tar.gz",
          "enabled": false,
          "checksumAlgorithm": "SHA-256",
          "metadata": {
            "packageProfile": "container",
            "packageVariant": "kubernetes",
            "releaseBuildDeferred": true,
            "requiresImmutableImageLock": true,
            "releaseAuthority": "sdkwork-agents"
          }
        }
      ]
    }
  },
  "release": {
    "currentVersion": "0.1.0",
    "defaultChannel": "BETA",
    "latest": {
      "BETA": "0.1.0"
    },
    "notes": [
      {
        "version": "0.1.0",
        "channel": "BETA",
        "current": true,
        "packageIds": [
          "linux-x64-standalone-server-tar-gz",
          "container-x64-cloud-container-kubernetes-tar-gz"
        ]
      }
    ]
  },
  "security": {
    "checksumRequired": true,
    "signatureRequired": true,
    "sbomRequired": true
  },
  "metadata": {
    "deploymentConfig": "etc/sdkwork.deployment.config.json",
    "topologySpec": "specs/topology.spec.json",
    "workflowManifest": "sdkwork.workflow.json",
    "kernelDependency": "../sdkwork-kernel"
  }
}
