{
  "name": "@sdkwork/agents-pc",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm dev:standalone",
    "build": "vite build && pnpm run check:bundle-budget",
    "preview": "vite preview",
    "clean": "node scripts/clean.mjs",
    "lint": "tsc --noEmit",
    "typecheck": "pnpm run lint",
    "test:agent-contract": "tsx --test tests/agent-catalog.test.ts tests/package-alignment.contract.test.mjs tests/sdk-services.contract.test.ts tests/workbench-modules.test.ts tests/chat-resilience.test.ts tests/chat-selected-model-memory.test.ts tests/chat-markdown.test.ts tests/chat-markdown-render.test.ts tests/chat-markdown-renderer-impl.test.ts tests/chat-message-order.test.ts",
    "test:iam-contract": "node --test tests/iam-integration.contract.test.mjs && tsx --test tests/auth-routing.test.ts tests/runtime-config.test.ts",
    "test:drive-contract": "tsx --test tests/drive-upload.contract.test.ts",
    "check:bundle-budget": "node scripts/check-bundle-budget.mjs",
    "test:agent-contracts": "pnpm run test:agent-contract && pnpm run test:iam-contract && pnpm run test:drive-contract",
    "dev:standalone": "pnpm exec sdkwork-app dev --root ../.. --deployment-profile standalone",
    "dev:cloud": "pnpm exec sdkwork-app dev --root ../.. --deployment-profile cloud",
    "stop": "pnpm exec sdkwork-app stop --root ../..",
    "test": "pnpm run test:agent-contracts",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "verify": "pnpm check",
    "build:dev": "node ../../../sdkwork-specs/tools/build-browser-client.mjs --app-root . --environment dev",
    "build:test": "node ../../../sdkwork-specs/tools/build-browser-client.mjs --app-root . --environment test",
    "build:staging": "node ../../../sdkwork-specs/tools/build-browser-client.mjs --app-root . --environment staging",
    "build:demo": "node ../../../sdkwork-specs/tools/build-browser-client.mjs --app-root . --environment demo",
    "build:prod": "node ../../../sdkwork-specs/tools/build-browser-client.mjs --app-root . --environment prod",
    "build:dev:cloud": "node ../../../sdkwork-specs/tools/build-browser-client.mjs --app-root . --environment dev --deployment-profile cloud",
    "build:test:cloud": "node ../../../sdkwork-specs/tools/build-browser-client.mjs --app-root . --environment test --deployment-profile cloud",
    "build:staging:cloud": "node ../../../sdkwork-specs/tools/build-browser-client.mjs --app-root . --environment staging --deployment-profile cloud",
    "build:demo:cloud": "node ../../../sdkwork-specs/tools/build-browser-client.mjs --app-root . --environment demo --deployment-profile cloud",
    "build:prod:cloud": "node ../../../sdkwork-specs/tools/build-browser-client.mjs --app-root . --environment prod --deployment-profile cloud"
  },
  "dependencies": {
    "@sdkwork/auth-pc-react": "workspace:*",
    "@sdkwork/auth-runtime-pc-react": "workspace:*",
    "@sdkwork/core-pc-react": "workspace:*",
    "@sdkwork/i18n-pc-react": "workspace:*",
    "@sdkwork/iam-contracts": "workspace:*",
    "@sdkwork/agents-pc-agents": "workspace:*",
    "@sdkwork/agents-pc-assets": "workspace:*",
    "@sdkwork/agents-pc-canvas": "workspace:*",
    "@sdkwork/agents-pc-chat": "workspace:*",
    "@sdkwork/agents-pc-commons": "workspace:*",
    "@sdkwork/agents-pc-core": "workspace:*",
    "@sdkwork/agents-pc-creative": "workspace:*",
    "@sdkwork/agents-pc-inspiration": "workspace:*",
    "@sdkwork/agents-pc-membership": "workspace:*",
    "@sdkwork/agents-pc-presentation": "workspace:*",
    "@sdkwork/membership-service": "workspace:*",
    "@sdkwork/order-service": "workspace:*",
    "@sdkwork/utils": "workspace:*",
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/vite": "^4.1.14",
    "@sdkwork/ui-pc-react": "workspace:*",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "html-to-image": "^1.11.13",
    "i18next": "^26.3.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-i18next": "^17.0.8",
    "react-router-dom": "^7.17.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.1.14",
    "tailwind-merge": "^3.6.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/react-syntax-highlighter": "^15.5.13",
    "autoprefixer": "^10.4.21",
    "tsx": "^4.21.0",
    "typescript": "~6.0.2",
    "vite": "^6.2.3"
  },
  "overrides": {
    "node-domexception": "npm:domexception@^4.0.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./agents": {
      "types": "./src/agents/index.ts",
      "import": "./src/agents/index.ts",
      "default": "./src/agents/index.ts"
    },
    "./workbench": {
      "types": "./src/workbench/index.ts",
      "import": "./src/workbench/index.ts",
      "default": "./src/workbench/index.ts"
    },
    "./workbench/i18n": {
      "types": "./src/workbench/i18n.ts",
      "import": "./src/workbench/i18n.ts",
      "default": "./src/workbench/i18n.ts"
    }
  }
}
