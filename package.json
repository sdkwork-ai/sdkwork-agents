{
  "name": "sdkwork-agents-workspace",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.17",
      "@types/react-dom": "19.2.3",
      "@sdkwork/sdk-common": "workspace:*"
    }
  },
  "dependencies": {
    "@sdkwork/app-topology": "workspace:*",
    "yaml": "^2.8.0"
  },
  "scripts": {
    "workflow:materialize-client-env": "node ../sdkwork-specs/tools/materialize-client-env.mjs --root .",
    "check:client-env": "node ../sdkwork-specs/tools/materialize-client-env.mjs --root . --check",
    "stop": "pnpm exec sdkwork-app stop",
    "dev": "pnpm dev:standalone",
    "dev:standalone": "pnpm exec sdkwork-app dev --deployment-profile standalone",
    "dev:cloud": "pnpm exec sdkwork-app dev --deployment-profile cloud",
    "build": "pnpm exec sdkwork-app build",
    "test": "pnpm exec sdkwork-app test",
    "check": "pnpm exec sdkwork-app check",
    "check:api-envelope": "node ../sdkwork-specs/tools/check-api-response-envelope.mjs --workspace .",
    "check:api-operation-patterns": "node ../sdkwork-specs/tools/check-api-operation-patterns.mjs --workspace .",
    "check:pagination": "node ../sdkwork-specs/tools/check-pagination.mjs --workspace .",
    "check:app-sdk-consumer-imports": "node ../sdkwork-specs/tools/check-app-sdk-consumer-imports.mjs --workspace .",
    "check:agent-sdk-workspace": "node scripts/check-agent-sdk-workspace.mjs",
    "check:agent-structured-call": "node scripts/check-agent-call-contract.mjs",
    "check:route-path-collisions": "node ../sdkwork-specs/tools/check-route-path-collisions.mjs --workspace .",
    "check:apps-directory-index": "node ../sdkwork-specs/tools/check-apps-directory-index.mjs --root .",
    "check:production-security": "node --test tests/contract/production-security.contract.test.mjs",
    "check:release-supply-chain": "node --test tests/contract/release-supply-chain.contract.test.mjs",
    "check:frontend-service-identity": "node --test tests/contract/frontend-service-identity.contract.test.mjs",
    "check:agents-im-boundary": "node --test tests/contract/agents-im-boundary.contract.test.mjs",
    "check:pc-upload-boundary": "node --test tests/contract/pc-upload-boundary.contract.test.mjs",
    "check:component-port-bindings": "node ../sdkwork-specs/tools/check-component-port-bindings.mjs --root .",
    "check:frontend-composition": "node ../sdkwork-specs/tools/check-frontend-composition.mjs --root .",
    "check:permission-composition": "node ../sdkwork-specs/tools/check-permission-composition.mjs --root .",
    "check:composition-resolver": "node ../sdkwork-specs/tools/check-composition-resolver.mjs --root .",
    "check:rust-backend-composition": "node ../sdkwork-specs/tools/check-rust-backend-composition.mjs --root .",
    "check:deploy": "node ../sdkwork-specs/tools/check-deploy-standard.mjs --root .",
    "deploy:validate": "pnpm exec sdkwork-app deploy:validate",
    "deploy:validate:standalone": "pnpm exec sdkwork-app deploy:validate --profile standalone.production",
    "deploy:validate:cloud": "pnpm exec sdkwork-app deploy:validate --profile cloud.production",
    "deploy:plan:standalone": "pnpm exec sdkwork-app deploy:plan --profile standalone.production",
    "deploy:plan:cloud": "pnpm exec sdkwork-app deploy:plan --profile cloud.production",
    "check:docs": "node ../sdkwork-specs/tools/check-repository-docs-standard.mjs --root .",
    "check:architecture-alignment": "node tools/check_sdkwork_agents_architecture_alignment.mjs",
    "check:identity-alignment": "node tools/check_agents_identity_alignment.mjs",
    "check:pnpm-script-standard": "node ../sdkwork-specs/tools/check-pnpm-script-standard.mjs --root . --product-prefix agents,agent",
    "check:agent-workflow-standard": "node ../sdkwork-specs/tools/check-agent-workflow-standard.mjs --root .",
    "check:source-config-standard": "node ../sdkwork-specs/tools/check-source-config-standard.mjs --root .",
    "check:contracts": "node --test tests/contract/platform-integration.contract.test.mjs tests/contract/database-framework.contract.test.mjs tests/contract/root-quality-gates.contract.test.mjs tests/contract/production-security.contract.test.mjs tests/contract/frontend-service-identity.contract.test.mjs tests/contract/agents-im-boundary.contract.test.mjs tests/contract/pc-upload-boundary.contract.test.mjs tests/contract/rust-service-module-boundaries.contract.test.mjs tests/contract/component-spec-inventory.contract.test.mjs tests/contract/dev-runtime-access.contract.test.mjs tests/contract/development-bootstrap.contract.test.mjs && node scripts/agents-open-sdk-surface-contract.test.mjs && node scripts/mini-program-runtime-contract.test.mjs && node scripts/client-surface-readiness-contract.test.mjs",
    "verify": "pnpm exec sdkwork-app verify",
    "clean": "pnpm exec sdkwork-app clean",
    "db:validate": "node ../sdkwork-specs/tools/check-database-framework-standard.mjs --root .",
    "test:database:postgres-live": "cargo test -p sdkwork-intelligence-agents-service --features postgres-sync --test resource_user_state_postgres_live -- --ignored --nocapture --test-threads=1",
    "db:materialize:contract": "node tools/database/materialize-agents-database-contract.mjs",
    "db:plan": "node scripts/agents-database.mjs plan",
    "db:init": "node scripts/agents-database.mjs init",
    "db:migrate": "node scripts/agents-database.mjs migrate",
    "db:seed": "node scripts/agents-database.mjs seed",
    "db:status": "node scripts/agents-database.mjs status",
    "db:drift": "node scripts/agents-database.mjs drift",
    "db:drift:check": "node scripts/agents-database.mjs drift-check",
    "db:bootstrap": "node scripts/agents-database.mjs bootstrap",
    "db:postgres:plan": "node ../sdkwork-specs/tools/postgres/postgres-db-cli.mjs --mode plan --config .env.postgres --app-root . --dry-run",
    "db:postgres:init": "node ../sdkwork-specs/tools/postgres/postgres-db-cli.mjs --mode init --config .env.postgres --app-root .",
    "db:postgres:migrate": "node scripts/agents-database.mjs migrate",
    "topology:validate": "node ../sdkwork-app-topology/scripts/sdkwork-topology.mjs validate --root . --spec specs/topology.spec.json",
    "topology:plan": "node ../sdkwork-app-topology/scripts/sdkwork-topology.mjs plan --root . --spec specs/topology.spec.json",
    "api:assembly:materialize": "node ../sdkwork-specs/tools/materialize-api-assembly.mjs --root .",
    "api:assembly:validate": "node ../sdkwork-specs/tools/validate-api-assembly.mjs --root .",
    "workflow:materialize-client-surfaces": "node scripts/materialize-client-app-surfaces.mjs",
    "workflow:sync-agent-h5-from-pc": "node scripts/materialize-h5-agents-from-pc.mjs && node scripts/sync-h5-core-from-pc.mjs",
    "workflow:build-agents-app-sdk": "pnpm --filter @sdkwork/agents-app-sdk build",
    "workflow:align-client-composition": "node scripts/align-client-dependency-composition.mjs",
    "start:desktop": "pnpm --filter @sdkwork/agents-pc dev",
    "start:browser": "pnpm --filter @sdkwork/agents-h5 dev",
    "start:mini-program": "pnpm --filter @sdkwork/agents-mini-program dev",
    "smoke:live": "node scripts/agents-live-smoke.mjs",
    "workflow:build-client-surfaces": "pnpm --filter @sdkwork/agents-pc build && pnpm --filter @sdkwork/agents-h5 build && pnpm --filter @sdkwork/agents-mini-program build",
    "workflow:typecheck-client-surfaces": "pnpm --filter @sdkwork/agents-pc typecheck && pnpm --filter @sdkwork/agents-h5 typecheck && pnpm --filter @sdkwork/agents-mini-program typecheck",
    "check:app-composition": "node ../sdkwork-specs/tools/verify-repo.mjs --root .",
    "_sdkwork:build": "cargo build --workspace --release",
    "_sdkwork:dev:standalone": "node scripts/agents-dev.mjs",
    "_sdkwork:test": "node scripts/cargo-test-workspace.mjs && node --test tests/contract/platform-integration.contract.test.mjs tests/contract/database-framework.contract.test.mjs tests/contract/root-quality-gates.contract.test.mjs tests/contract/production-security.contract.test.mjs tests/contract/frontend-service-identity.contract.test.mjs tests/contract/agents-im-boundary.contract.test.mjs tests/contract/rust-service-module-boundaries.contract.test.mjs tests/contract/component-spec-inventory.contract.test.mjs tests/contract/dev-runtime-access.contract.test.mjs tests/contract/development-bootstrap.contract.test.mjs && node scripts/agents-open-sdk-surface-contract.test.mjs && node scripts/mini-program-runtime-contract.test.mjs && node scripts/client-surface-readiness-contract.test.mjs",
    "_sdkwork:check": "pnpm run check:app-composition && pnpm check:component-port-bindings && pnpm check:frontend-composition && pnpm check:frontend-service-identity && pnpm check:agents-im-boundary && pnpm check:pc-upload-boundary && pnpm check:permission-composition && pnpm check:composition-resolver && pnpm check:rust-backend-composition && pnpm check:architecture-alignment && pnpm check:identity-alignment && pnpm check:api-envelope && pnpm check:api-operation-patterns && pnpm check:route-path-collisions && pnpm check:pagination && pnpm check:app-sdk-consumer-imports && pnpm check:agent-sdk-workspace && pnpm check:apps-directory-index && pnpm check:production-security && pnpm check:release-supply-chain && pnpm check:deploy && pnpm check:source-config-standard && pnpm deploy:validate:cloud && pnpm check:docs && pnpm check:pnpm-script-standard && pnpm check:agent-workflow-standard && pnpm topology:validate && pnpm db:validate",
    "_sdkwork:verify": "pnpm check && pnpm workflow:build-agents-app-sdk && cargo build --workspace && node scripts/cargo-test-workspace.mjs && pnpm --filter @sdkwork/agents-mini-program build && pnpm check:contracts && pnpm workflow:typecheck-client-surfaces && pnpm --filter @sdkwork/agents-pc test:agent-contracts",
    "_sdkwork:clean": "cargo clean",
    "build:h5:dev": "node ../sdkwork-specs/tools/build-browser-client.mjs --root . --architecture h5 --environment dev",
    "build:h5:test": "node ../sdkwork-specs/tools/build-browser-client.mjs --root . --architecture h5 --environment test",
    "build:h5:staging": "node ../sdkwork-specs/tools/build-browser-client.mjs --root . --architecture h5 --environment staging",
    "build:h5:demo": "node ../sdkwork-specs/tools/build-browser-client.mjs --root . --architecture h5 --environment demo",
    "build:h5:prod": "node ../sdkwork-specs/tools/build-browser-client.mjs --root . --architecture h5 --environment prod",
    "build:pc:dev": "node ../sdkwork-specs/tools/build-browser-client.mjs --root . --architecture pc --environment dev",
    "build:pc:test": "node ../sdkwork-specs/tools/build-browser-client.mjs --root . --architecture pc --environment test",
    "build:pc:staging": "node ../sdkwork-specs/tools/build-browser-client.mjs --root . --architecture pc --environment staging",
    "build:pc:demo": "node ../sdkwork-specs/tools/build-browser-client.mjs --root . --architecture pc --environment demo",
    "build:pc:prod": "node ../sdkwork-specs/tools/build-browser-client.mjs --root . --architecture pc --environment prod",
    "check:browser-build-scripts": "node ../sdkwork-specs/tools/check-browser-build-scripts.mjs --root .",
    "build:h5:dev:cloud": "node ../sdkwork-specs/tools/build-browser-client.mjs --root . --architecture h5 --environment dev --deployment-profile cloud",
    "build:h5:test:cloud": "node ../sdkwork-specs/tools/build-browser-client.mjs --root . --architecture h5 --environment test --deployment-profile cloud",
    "build:h5:staging:cloud": "node ../sdkwork-specs/tools/build-browser-client.mjs --root . --architecture h5 --environment staging --deployment-profile cloud",
    "build:h5:demo:cloud": "node ../sdkwork-specs/tools/build-browser-client.mjs --root . --architecture h5 --environment demo --deployment-profile cloud",
    "build:h5:prod:cloud": "node ../sdkwork-specs/tools/build-browser-client.mjs --root . --architecture h5 --environment prod --deployment-profile cloud",
    "build:pc:dev:cloud": "node ../sdkwork-specs/tools/build-browser-client.mjs --root . --architecture pc --environment dev --deployment-profile cloud",
    "build:pc:test:cloud": "node ../sdkwork-specs/tools/build-browser-client.mjs --root . --architecture pc --environment test --deployment-profile cloud",
    "build:pc:staging:cloud": "node ../sdkwork-specs/tools/build-browser-client.mjs --root . --architecture pc --environment staging --deployment-profile cloud",
    "build:pc:demo:cloud": "node ../sdkwork-specs/tools/build-browser-client.mjs --root . --architecture pc --environment demo --deployment-profile cloud",
    "build:pc:prod:cloud": "node ../sdkwork-specs/tools/build-browser-client.mjs --root . --architecture pc --environment prod --deployment-profile cloud"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  }
}
